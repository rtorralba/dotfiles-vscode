#!/bin/bash

echo "Setting up workspace folder: $WORKSPACE_FOLDER"
cd $WORKSPACE_FOLDER
rm -rf "$WORKSPACE_FOLDER/.vscode"
ln -s "$HOME/dotfiles/.vscode" "$WORKSPACE_FOLDER/.vscode"

# Snippets de PHP: se generan desde el autoload psr-4 del composer.json del proyecto
if command -v php &> /dev/null; then
    php "$HOME/dotfiles/generate-snippets.php" "$WORKSPACE_FOLDER/composer.json" "$HOME/dotfiles/snippets/php.code-snippets.tpl" > "$HOME/dotfiles/.vscode/php.code-snippets"
else
    echo "'php' not found, PHP snippets not generated"
fi

if ! grep -q "alias install-extensions=" "$HOME/.bashrc" 2>/dev/null; then
    echo "alias install-extensions='WORKSPACE_FOLDER=\"$WORKSPACE_FOLDER\" bash \$HOME/dotfiles/install-extensions.sh'" >> "$HOME/.bashrc"
fi
echo "Run 'install-extensions' from a new terminal once VSCode's 'code' CLI is available"
